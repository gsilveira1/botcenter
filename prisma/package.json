{
  "name": "@botcenter/prisma",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema and SQL migrations of Bot Center (tooling package, not a library)",
  "scripts": {
    "build": "prisma generate --config prisma.config.ts",
    "generate": "prisma generate --config prisma.config.ts",
    "validate": "prisma validate --config prisma.config.ts",
    "migrate": "prisma migrate deploy --config prisma.config.ts",
    "migrate:status": "prisma migrate status --config prisma.config.ts",
    "lint": "prisma validate --config prisma.config.ts && eslint prisma.config.ts test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:int": "vitest run --config vitest.int.config.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@botcenter/config": "workspace:*",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "eslint": "^9.39.5",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
