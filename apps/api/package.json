{
  "name": "@botcenter/api",
  "version": "0.1.0",
  "private": true,
  "description": "Bot Center API (ROLE=api) and workers (ROLE=worker): NestJS 11 on Fastify",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:int": "vitest run --config vitest.int.config.mts",
    "openapi": "tsc -p tsconfig.build.json && node dist/scripts/export-openapi.js",
    "db:migrate": "prisma migrate deploy --config ../../prisma/prisma.config.ts",
    "admin:tenant:create": "node dist/scripts/admin.js tenant:create",
    "admin:tenant:update-quotas": "node dist/scripts/admin.js tenant:update-quotas",
    "admin:key:create": "node dist/scripts/admin.js key:create",
    "admin:key:list": "node dist/scripts/admin.js key:list",
    "admin:key:revoke": "node dist/scripts/admin.js key:revoke",
    "admin:key:rotate": "node dist/scripts/admin.js key:rotate",
    "admin:raw-events:replay": "node dist/scripts/admin.js raw-events:replay",
    "admin:instances:resync-webhook": "node dist/scripts/admin.js instances:resync-webhook"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@botcenter/contracts": "workspace:*",
    "@botcenter/engine": "workspace:*",
    "@botcenter/whatsapp-provider": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^5.81.5",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@botcenter/config": "workspace:*",
    "@botcenter/prisma": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.16.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@testcontainers/redis": "^12.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "eslint": "^9.39.5",
    "testcontainers": "^12.0.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.12"
  }
}
