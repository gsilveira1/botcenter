{
  "openapi": "3.1.0",
  "info": {
    "title": "Bot Center API",
    "version": "0.1.0",
    "description": "Gateway and bot engine in front of the WhatsApp provider. Errors are RFC 9457 Problem Details (`application/problem+json`) with a stable `code`. Write requests accept `Idempotency-Key`."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "Health_live",
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process answers",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "Health_ready",
        "tags": [
          "health"
        ],
        "summary": "Readiness: PostgreSQL, Redis, and the WhatsApp provider answer",
        "security": [],
        "responses": {
          "200": {
            "description": "All checks are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "One check is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media": {
      "post": {
        "operationId": "Media_create",
        "tags": [
          "media"
        ],
        "summary": "Get a pre-signed upload URL for a media file",
        "description": "Send the bytes with `PUT upload_url`, the same `Content-Type`, and exactly `size_bytes` bytes before `expires_at`. Then use `media_id` in `POST /v1/messages`. The bucket is private. Accepted types (image: image/jpeg, image/png, image/webp; video: video/mp4, video/3gpp; audio: audio/aac, audio/mp4, audio/mpeg, audio/amr, audio/ogg; document: application/pdf, text/plain, text/csv, application/zip, application/msword, application/vnd.ms-excel, application/vnd.ms-powerpoint, application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.openxmlformats-officedocument.presentationml.presentation). A `document` message accepts every type of the list.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scopes": [
          "messages:send"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "The same key with the same request returns the stored response for 24 h.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMediaUploadBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMediaUploadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (`VALIDATION_FAILED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key (`UNAUTHENTICATED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Scope or instance not allowed (`SCOPE_MISSING`, `INSTANCE_NOT_ALLOWED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict (`IDEMPOTENCY_KEY_REUSED`, `IDEMPOTENCY_IN_PROGRESS`) or state conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit of the API key (`RATE_LIMITED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "Messages_send",
        "tags": [
          "messages"
        ],
        "summary": "Queue a message",
        "description": "Queues one message and answers 202 at once. The worker sends it later; read the status with\n`GET /v1/messages/{id}` or the `message.status` webhook event.\n\n- `priority: reply` goes before `bulk` in the queue. The daily quota of the tenant\n  (`maxMessagesPerDay`, UTC day) counts every message of this route; 429 `QUOTA_EXCEEDED` has\n  `Retry-After` until 00:00 UTC.\n- The instance must belong to the tenant (else 403). An instance without a WhatsApp session\n  (`created`, `logged_out`) gives 409 `INSTANCE_NOT_CONNECTED`. A `connecting` or `disconnected`\n  instance accepts the message; the worker retries for about 12 minutes, then the status is\n  `failed` with `failure_reason: not_connected`.\n- Each instance has a send rate (token bucket). A new number sends slower during its first days\n  (warm-up). A message that waits for the rate limit stays `queued`.\n- Delivery is at least once. When a send times out, the provider can have sent the message, and\n  the retry (after 60 s or more) can send it a second time. After two such timeouts the status is\n  `failed` with `failure_reason: send_timeout`.\n- `failure_reason` values: `invalid_recipient`, `instance_not_found`, `rejected`, `not_connected`,\n  `provider_unavailable`, `send_timeout`, `instance_deleted`, `instance_not_connected`,\n  `media_not_found`, `media_not_uploaded`, `internal_error`, `provider_error`.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scopes": [
          "messages:send"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "The same key with the same request returns the stored response for 24 h.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageBody"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (`VALIDATION_FAILED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key (`UNAUTHENTICATED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Scope or instance not allowed (`SCOPE_MISSING`, `INSTANCE_NOT_ALLOWED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict (`IDEMPOTENCY_KEY_REUSED`, `IDEMPOTENCY_IN_PROGRESS`) or state conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit of the API key (`RATE_LIMITED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages/{id}": {
      "get": {
        "operationId": "Messages_get",
        "tags": [
          "messages"
        ],
        "summary": "Read the status of a message",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-required-scopes": [
          "messages:send"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid (`VALIDATION_FAILED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key (`UNAUTHENTICATED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Scope or instance not allowed (`SCOPE_MISSING`, `INSTANCE_NOT_ALLOWED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit of the API key (`RATE_LIMITED`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "default": {
            "description": "Error (Problem Details)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMediaUploadBody": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "maxLength": 127,
            "pattern": "^[a-z]+\\/[a-z0-9][a-z0-9.+-]*$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "file_name": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": [
          "content_type",
          "size_bytes",
          "file_name"
        ]
      },
      "CreateMediaUploadResponseDto": {
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "upload_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "media_id",
          "upload_url",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "to_masked": {
            "type": "string",
            "pattern": "^\\d{2,6}\\*+\\d{2,4}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "media",
              "buttons",
              "list"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "sent",
              "delivered",
              "read",
              "failed"
            ]
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "instance_id",
          "to_masked",
          "type",
          "status",
          "failure_reason",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "SCOPE_MISSING",
              "INSTANCE_NOT_ALLOWED",
              "NOT_FOUND",
              "CONFLICT",
              "IDEMPOTENCY_KEY_REUSED",
              "IDEMPOTENCY_IN_PROGRESS",
              "RATE_LIMITED",
              "QUOTA_EXCEEDED",
              "INSTANCE_NOT_CONNECTED",
              "CONNECT_TOKEN_INVALID",
              "BOT_DEFINITION_INVALID",
              "WEBHOOK_URL_FORBIDDEN",
              "PROVIDER_UNAVAILABLE",
              "INTERNAL"
            ]
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "latency_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "latency_ms"
                ],
                "additionalProperties": false
              },
              "redis": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "latency_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "latency_ms"
                ],
                "additionalProperties": false
              },
              "provider": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "up",
                      "down"
                    ]
                  },
                  "latency_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "latency_ms"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "database",
              "redis",
              "provider"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "SendMessageBody": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "instance_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "to": {
                "type": "string",
                "pattern": "^[1-9]\\d{9,14}$"
              },
              "priority": {
                "default": "bulk",
                "type": "string",
                "enum": [
                  "reply",
                  "bulk"
                ]
              },
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "instance_id",
              "to",
              "type",
              "text"
            ]
          },
          {
            "type": "object",
            "properties": {
              "instance_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "to": {
                "type": "string",
                "pattern": "^[1-9]\\d{9,14}$"
              },
              "priority": {
                "default": "bulk",
                "type": "string",
                "enum": [
                  "reply",
                  "bulk"
                ]
              },
              "type": {
                "type": "string",
                "const": "media"
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
