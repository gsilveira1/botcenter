{
  "name": "@botcenter/whatsapp-provider",
  "version": "0.0.0",
  "private": true,
  "description": "WhatsAppProvider interface, the Evolution API adapter, the normalizer of provider webhooks, and a fake Evolution server for tests",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "fake-evolution": "node dist/testing/fake-evolution-cli.js"
  },
  "dependencies": {
    "@botcenter/contracts": "workspace:*",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@botcenter/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "testcontainers": "^12.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
