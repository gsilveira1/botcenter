{
  "name": "@botcenter/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas of the public API, scopes, error codes, event payloads, bot definitions, and webhook signatures",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@botcenter/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
