{
  "name": "@botcenter/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure state machine engine of the bot conversations: conditions, actions, timers, and definition checks",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@botcenter/contracts": "workspace:*",
    "re2": "^1.27.0"
  },
  "devDependencies": {
    "@botcenter/config": "workspace:*",
    "@botcenter/whatsapp-provider": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
