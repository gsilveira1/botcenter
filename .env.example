# Bot Center environment. Copy to `.env` (mode 600) for local runs. Never commit a real value.
# The API (`apps/api`) validates these values at start. The list grows with each slice.

# --- Process ---
NODE_ENV=development
# `api` runs the HTTP server. `worker` runs the queue workers.
ROLE=api
PORT=3000
LOG_LEVEL=info
# Public base URL of the API. The connect route builds `events_url` from it.
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL 16 (database `botcenter`) ---
# Connection of the API and the workers.
DATABASE_URL=postgresql://botcenter_app:change-me@localhost:5432/botcenter
# Connection of the table owner, for `prisma migrate deploy`.
DATABASE_URL_MIGRATE=postgresql://botcenter_owner:change-me@localhost:5432/botcenter

# --- Redis 7 (BullMQ, rate limits, key cache, locks, hot conversation state) ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets (32 random bytes each, for example `openssl rand -base64 32`) ---
# Pepper of the API key hashes: sha256(pepper + secret).
API_KEY_PEPPER=
# AES-256-GCM key (base64, 32 bytes) that encrypts the webhook secrets in `webhook_subscriptions`.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# --- Evolution API (internal network only) ---
EVOLUTION_BASE_URL=http://localhost:8080
# Global key of the Evolution API (`AUTHENTICATION_API_KEY` of the Evolution container).
EVOLUTION_API_KEY=
# Secret that the Evolution API sends to `POST /internal/evolution/webhook`.
EVOLUTION_WEBHOOK_SECRET=

# --- Object storage (S3 API: MinIO in local runs, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=botcenter-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Alerts ---
# Discord webhook of the operations channel. Empty: the API logs the alert as an error only.
DISCORD_WEBHOOK_URL=
