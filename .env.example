# Bot Center environment. Copy to `.env` (mode 600) for local runs. Never commit a real value.
# The API and the workers (`apps/api`, `src/config/env.ts`) validate these values at start and stop on
# an invalid value. An empty optional value is the same as a missing value.

# --- Process ---
NODE_ENV=development
# `api` runs the HTTP server (`dist/main.js`). `worker` runs the queue workers (`dist/worker.js`).
ROLE=api
PORT=3000
# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Public base URL of the API. The connect route builds `events_url` from it.
PUBLIC_BASE_URL=http://localhost:3000

# --- PostgreSQL 16 (database `botcenter`) ---
# Connection of the API and the workers.
DATABASE_URL=postgresql://botcenter_app:change-me@localhost:5432/botcenter
DATABASE_POOL_SIZE=10
# Connection of the table owner, for `prisma migrate deploy` (not read by the API).
DATABASE_URL_MIGRATE=postgresql://botcenter_owner:change-me@localhost:5432/botcenter

# --- Redis 7 (BullMQ, rate limits, key cache, locks, dedupe, hot conversation state) ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets (32 random bytes each, for example `openssl rand -base64 32`) ---
# Pepper of the API key hashes: sha256(pepper + secret). At least 32 characters.
API_KEY_PEPPER=
# AES-256-GCM key (base64 of exactly 32 bytes) of `SecretBox`: it encrypts the webhook secrets.
DATA_ENCRYPTION_KEY=

# --- Evolution API (internal network only) ---
EVOLUTION_URL=http://localhost:8080
# Global key of the Evolution API (`AUTHENTICATION_API_KEY` of the Evolution container).
EVOLUTION_API_KEY=
# Secret that the Evolution API sends in `x-botcenter-webhook-secret` to `POST /internal/evolution/webhook`.
# At least 32 characters.
EVOLUTION_WEBHOOK_SECRET=
# Base URL of the API on the internal Docker network. The provider webhook is
# `<INTERNAL_WEBHOOK_BASE_URL>/internal/evolution/webhook`.
INTERNAL_WEBHOOK_BASE_URL=http://api:3000
# How the adapter sends `buttons` and `list` content: `text` (a numbered text menu, the default) or
# `native` (many WhatsApp clients do not show the native messages; see packages/whatsapp-provider/README.md).
EVOLUTION_INTERACTIVE_FALLBACK=text
# Time limits of the Evolution requests. Request: state, create, logout, delete, and the readiness ping.
# Send: one message (the adapter adds the typing delay). Maximum 300000 each.
EVOLUTION_REQUEST_TIMEOUT_MS=10000
EVOLUTION_CONNECT_TIMEOUT_MS=20000
EVOLUTION_SEND_TIMEOUT_MS=30000
EVOLUTION_MEDIA_TIMEOUT_MS=60000

# --- Object storage (S3 API: MinIO in local runs, Cloudflare R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=botcenter-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Alerts ---
# Discord webhook (HTTPS) of the operations channel. Empty: the API logs each alert at `error` only.
ALERT_DISCORD_WEBHOOK_URL=

# --- HTTP (API process) ---
# Proxies that Fastify trusts for X-Forwarded-For. The default trusts only private addresses (Caddy).
TRUST_PROXY=loopback,linklocal,uniquelocal
# Maximum JSON body (1 MiB) and maximum body of the provider webhook (8 MiB).
BODY_LIMIT_BYTES=1048576
INTERNAL_WEBHOOK_BODY_LIMIT_BYTES=8388608
# Keep it above the idle timeout of Caddy.
KEEP_ALIVE_TIMEOUT_MS=65000
# Maximum time of a graceful shutdown (current requests and current jobs).
SHUTDOWN_TIMEOUT_MS=25000

# --- Worker process ---
# Internal listener of the worker: GET /metrics and GET /health/live.
WORKER_METRICS_PORT=9464
WORKER_CONCURRENCY_OUTBOUND=10
WORKER_CONCURRENCY_INBOUND=10
WORKER_CONCURRENCY_WEBHOOKS=10
WORKER_CONCURRENCY_TIMERS=5
WORKER_CONCURRENCY_MAINTENANCE=1
# Pause of the outbox dispatcher loop when no event waits (milliseconds).
OUTBOX_DISPATCH_INTERVAL_MS=1000

# --- External HTTP (webhook deliveries, the `external` condition, `call_webhook`) ---
# Tests and development only: the SSRF guard accepts private, loopback, and link-local addresses.
# The process refuses to start with `true` when NODE_ENV=production. HTTP (not HTTPS) URLs are accepted
# only when NODE_ENV is not production.
EXTERNAL_HTTP_ALLOW_PRIVATE=false
# Maximum response body of an external call (1 MiB).
EXTERNAL_HTTP_MAX_RESPONSE_BYTES=1048576

# --- Admin CLI ---
# Audit actor of the admin scripts (`cli:<name>`). Default: $USER.
BOTCENTER_OPERATOR=
