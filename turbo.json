{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["DATABASE_URL", "TESTCONTAINERS_RYUK_DISABLED", "DOCKER_HOST"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@botcenter/prisma#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
