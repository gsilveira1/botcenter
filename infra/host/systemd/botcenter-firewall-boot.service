[Unit]
Description=Bot Center: apply the DOCKER-USER rules (last known Cloudflare ranges, Evolution egress) before Docker starts
Documentation=file:///opt/botcenter/docs/runbook.md
# No network yet: the script reads the ranges from the Caddy snippet. The timer
# botcenter-cloudflare-firewall.timer fetches the current ranges after the boot.
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service systemd-sysctl.service
Before=docker.service network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/botcenter/firewall.env
ExecStart=/opt/botcenter/infra/host/firewall-cloudflare.sh --offline
TimeoutStartSec=2m

[Install]
WantedBy=docker.service
