[Unit]
Description=Bot Center: monthly restore test of the latest backup
Documentation=file:///opt/botcenter/docs/runbook.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/botcenter/backup.env
ExecStart=/opt/botcenter/infra/backup/restore-test.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
# The script runs as root (Docker access). The service can write only to its own directories.
ProtectSystem=strict
ReadWritePaths=/var/lib/botcenter /var/cache/botcenter-restic
PrivateTmp=true
NoNewPrivileges=true
