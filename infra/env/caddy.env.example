# Caddy (infra/caddy/Caddyfile). No secret in this file.
# The public host name of the API. Cloudflare proxies it (orange cloud).
BOTCENTER_DOMAIN=CHANGE_ME
# The arguments of the `tls` directive. Origin mode (recommended, Cloudflare SSL "Full (strict)"):
CADDY_TLS=/etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
# ACME mode (Let's Encrypt; the firewall must open port 80 for Cloudflare): an e-mail address.
#CADDY_TLS=ops@CHANGE_ME
