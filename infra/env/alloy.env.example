# Grafana Alloy (infra/observability/alloy/config.alloy). Grafana Cloud > Stack > Details. Mode 600.
# The host label of the logs and the metrics.
BOTCENTER_HOST_NAME=botcenter-prod-1
# Prometheus (Mimir) remote write: URL, numeric user id.
GRAFANA_CLOUD_PROM_URL=https://CHANGE_ME.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=CHANGE_ME
# Loki: URL, numeric user id.
GRAFANA_CLOUD_LOKI_URL=https://CHANGE_ME.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=CHANGE_ME
# An access policy token with the scopes metrics:write and logs:write only.
GRAFANA_CLOUD_API_TOKEN=CHANGE_ME
# The Redis ACL user `metrics` (INFO only) of the Redis exporter.
REDIS_METRICS_PASSWORD=__REDIS_METRICS_PASSWORD__
