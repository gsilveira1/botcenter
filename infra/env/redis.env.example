# Redis 7 container. Mode 600. One ACL user for each client (SEC-11, compose.prod.yml).
# `default`: the operators and the health check. Only this file has it.
REDIS_PASSWORD=__REDIS_PASSWORD__
# `botcenter`: the API and the workers (also in api.env, REDIS_URL).
REDIS_BOTCENTER_PASSWORD=__REDIS_BOTCENTER_PASSWORD__
# `evolution`: the cache of the Evolution API (also in evolution.env, CACHE_REDIS_URI).
REDIS_EVOLUTION_PASSWORD=__REDIS_EVOLUTION_PASSWORD__
# `metrics`: the Redis exporter of Alloy, INFO only (also in alloy.env).
REDIS_METRICS_PASSWORD=__REDIS_METRICS_PASSWORD__
