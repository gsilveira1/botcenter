# restic repository on Cloudflare R2 (bucket `botcenter-backups`). Mode 600.
# Only the restic container gets this file (infra/backup/restic.sh).
RESTIC_REPOSITORY=s3:https://CHANGE_ME.r2.cloudflarestorage.com/botcenter-backups
# The encryption password of the repository. WARNING: without it, no backup can be restored.
# Keep a second copy outside the host (password manager).
RESTIC_PASSWORD=__RESTIC_PASSWORD__
# An R2 API token with "Object Read & Write" on the bucket `botcenter-backups` only. R2 has no token
# without the delete right: the bucket lock (35 days, docs/runbook.md procedure 4) protects the backups.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
