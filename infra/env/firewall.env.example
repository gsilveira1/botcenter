# infra/host/firewall-cloudflare.sh (systemd timer `botcenter-cloudflare-firewall`). Mode 600.
# Backends, separated by commas: `docker-user` (iptables on the host, no token) and `hcloud`
# (Hetzner Cloud Firewall; needs HCLOUD_TOKEN). Use both for two layers.
FIREWALL_BACKENDS=docker-user
# Open port 80 for Cloudflare too (Caddy ACME mode only).
ALLOW_HTTP=false
# The host copy of the Caddy snippet. The script writes it and reloads Caddy when the ranges change.
CADDY_SNIPPET=/etc/botcenter/caddy/cloudflare-ips.caddy
BOTCENTER_COMPOSE_PROJECT=botcenter
# hcloud backend: a token of a Hetzner project that has only this server.
HCLOUD_TOKEN=
HCLOUD_FIREWALL_NAME=botcenter-edge
HCLOUD_SERVER_NAME=botcenter-prod-1
ALERT_DISCORD_WEBHOOK_URL=CHANGE_ME
