# PostgreSQL 16 container. infra/postgres/init/01-databases.sh reads the role passwords on the first start.
# A change of a value here after the first start has no effect: use docs/runbook.md, "Rotate a secret". Mode 600.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
BOTCENTER_OWNER_PASSWORD=__BOTCENTER_OWNER_PASSWORD__
BOTCENTER_APP_PASSWORD=__BOTCENTER_APP_PASSWORD__
EVOLUTION_DB_PASSWORD=__EVOLUTION_DB_PASSWORD__
