# Interpolation values of infra/compose/compose.prod.yml (`--env-file /etc/botcenter/compose.env`).
# No secret in this file. Mode 600 like the other files of /etc/botcenter.

# The only image repository that deploy.sh accepts (SEC-12). Use the lowercase owner of the repository.
BOTCENTER_IMAGE_REPOSITORY=ghcr.io/CHANGE_ME/botcenter-api
# The image of the API and the workers: tag AND digest (the release workflow prints both).
BOTCENTER_IMAGE=ghcr.io/CHANGE_ME/botcenter-api:v0.1.0@sha256:CHANGE_ME
# The directory of the env files of each service.
BOTCENTER_ENV_DIR=/etc/botcenter
# The label `environment` of the logs and the metrics in Grafana Cloud.
BOTCENTER_ENVIRONMENT=production
# The numeric group of the journal files (`getent group systemd-journal`). Alloy (uid 473) gets only
# this group to read the container logs (SEC-07). gen-secrets.sh fills it on the host.
BOTCENTER_JOURNAL_GID=__BOTCENTER_JOURNAL_GID__
# The host copy of the Cloudflare ranges (infra/host/firewall-cloudflare.sh writes it).
CADDY_CLOUDFLARE_IPS_FILE=/etc/botcenter/caddy/cloudflare-ips.caddy

# Extra Compose files (comma-separated names in infra/compose). infra/scripts/compose.sh reads it.
# The CX22 start host (4 GB) uses the memory profile compose.prod.cx22.yml. Empty on the CX32 (8 GB).
BOTCENTER_COMPOSE_EXTRA_FILES=compose.prod.cx22.yml

# Memory profile. The defaults of compose.prod.yml are for the CX32 (8 GB).
#API_MEMORY=512M
#API_HEAP_MB=384
#WORKER_MEMORY=1G
#WORKER_HEAP_MB=768
#EVOLUTION_MEMORY=3G
#POSTGRES_MEMORY=2G
#PG_SHARED_BUFFERS=512MB
#PG_EFFECTIVE_CACHE_SIZE=1536MB
#REDIS_MEMORY=512M
#REDIS_MAXMEMORY=384mb
