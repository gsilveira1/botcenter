# Bot Center API and workers (services `api` and `worker` of compose.prod.yml). Mode 600.
# compose.prod.yml sets ROLE, PORT, WORKER_METRICS_PORT, and NODE_OPTIONS for each service.
NODE_ENV=production
LOG_LEVEL=info
# The public base URL. The connect route builds `events_url` from it.
PUBLIC_BASE_URL=https://CHANGE_ME

# PostgreSQL: the application role only (no DDL). The migrate service uses migrate.env.
DATABASE_URL=postgresql://botcenter_app:__BOTCENTER_APP_PASSWORD__@postgres:5432/botcenter
# Redis database 0 (database 1 is the cache of the Evolution API).
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0

# Pepper of the API key hashes: sha256(pepper + secret). Do not change it: every key stops working.
API_KEY_PEPPER=__API_KEY_PEPPER__
# AES-256-GCM key (base64, 32 bytes) of the webhook secrets in `webhook_subscriptions`.
WEBHOOK_SECRET_ENCRYPTION_KEY=__WEBHOOK_SECRET_ENCRYPTION_KEY__

# Evolution API on the internal network.
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=__EVOLUTION_API_KEY__
# The secret that the Evolution API sends to POST /internal/evolution/webhook.
EVOLUTION_WEBHOOK_SECRET=__EVOLUTION_WEBHOOK_SECRET__
# The URL that the API gives to each Evolution instance for its webhook (internal network only).
EVOLUTION_WEBHOOK_URL=http://api:3000/internal/evolution/webhook

# Media: Cloudflare R2 (S3 API). The bucket is private; the API gives short pre-signed URLs.
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=botcenter-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Discord webhook of the operations channel (AlertService).
DISCORD_WEBHOOK_URL=CHANGE_ME
