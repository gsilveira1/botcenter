# Bot Center API and workers (services `api` and `worker` of compose.prod.yml). Mode 600.
# Names and rules: apps/api/src/config/env.ts (the process stops on an invalid value).
# compose.prod.yml sets ROLE, PORT, the metrics listeners, and NODE_OPTIONS for each service.
# tests/infra fails when env.ts has a name that this file (or compose.prod.yml) does not list.
# The values after "Tunables" are the defaults of env.ts. Change them only for a known reason.
NODE_ENV=production
LOG_LEVEL=info
# The public base URL. The connect route builds `events_url` from it.
PUBLIC_BASE_URL=https://CHANGE_ME
# REQUIRED for the connect flow: the browser origins (comma list, no path) of the client products that
# open the connect event stream, for example https://app.personallife.com.br. Without a listed origin,
# the browser blocks the stream and the user never sees the QR code (docs/runbook.md, procedure 7).
CONNECT_ALLOWED_ORIGINS=https://CHANGE_ME

# PostgreSQL: the application role only (no DDL). The migrate service uses migrate.env.
DATABASE_URL=postgresql://botcenter_app:__BOTCENTER_APP_PASSWORD__@postgres:5432/botcenter
DATABASE_POOL_SIZE=10
# Redis database 0 (database 1 is the cache of the Evolution API). The ACL user `botcenter` can use only
# the keys `bc:*` and `bull:*` (SEC-11).
REDIS_URL=redis://botcenter:__REDIS_BOTCENTER_PASSWORD__@redis:6379/0

# Pepper of the API key hashes: sha256(pepper + secret). Do not change it: every key stops working.
API_KEY_PEPPER=__API_KEY_PEPPER__
# AES-256-GCM key (base64 of 32 bytes) of the webhook secrets. Do not change it without a re-encryption.
DATA_ENCRYPTION_KEY=__DATA_ENCRYPTION_KEY__

# Evolution API on the internal network.
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=__EVOLUTION_API_KEY__
# The secret that the Evolution API sends in `x-botcenter-webhook-secret` to POST /internal/evolution/webhook.
EVOLUTION_WEBHOOK_SECRET=__EVOLUTION_WEBHOOK_SECRET__
# The base URL of the API on the internal network. Each instance gets
# <INTERNAL_WEBHOOK_BASE_URL>/internal/evolution/webhook. Caddy never forwards /internal/*.
INTERNAL_WEBHOOK_BASE_URL=http://api:3000

# Media: Cloudflare R2 (S3 API). The bucket is private; the API gives short pre-signed URLs.
S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=botcenter-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# Discord webhook (HTTPS) of the operations channel (AlertService).
ALERT_DISCORD_WEBHOOK_URL=CHANGE_ME

# --- Tunables (the defaults of env.ts) ---

# HTTP. Fastify trusts X-Forwarded-For only from private addresses (Caddy on the edge network).
# Caddy sends one value: the client IP (CF-Connecting-IP from a Cloudflare range).
TRUST_PROXY=loopback,linklocal,uniquelocal
# Maximum JSON body of a request (1 MiB), and of the Evolution webhook (8 MiB).
BODY_LIMIT_BYTES=1048576
INTERNAL_WEBHOOK_BODY_LIMIT_BYTES=8388608
# Above the upstream keep-alive of Caddy (60 s, infra/caddy/Caddyfile).
KEEP_ALIVE_TIMEOUT_MS=65000
# Below the stop_grace_period of compose.prod.yml (30 s).
SHUTDOWN_TIMEOUT_MS=25000

# Evolution adapter. `text` sends buttons and lists as a numbered text menu; `native` sends the native
# messages, which many WhatsApp clients do not show.
EVOLUTION_INTERACTIVE_FALLBACK=text
# Time limits of the Evolution requests (maximum 300000 each). Request: state, create, logout, delete,
# and the readiness ping. Send: one message (the adapter adds the typing delay).
EVOLUTION_REQUEST_TIMEOUT_MS=10000
EVOLUTION_CONNECT_TIMEOUT_MS=20000
EVOLUTION_SEND_TIMEOUT_MS=30000
EVOLUTION_MEDIA_TIMEOUT_MS=60000

# Workers: the jobs that each queue runs at the same time.
WORKER_CONCURRENCY_OUTBOUND=10
WORKER_CONCURRENCY_INBOUND=10
WORKER_CONCURRENCY_WEBHOOKS=10
WORKER_CONCURRENCY_TIMERS=5
WORKER_CONCURRENCY_MAINTENANCE=1
WORKER_CONCURRENCY_INSTANCES=1

# Outbound sends. The rate of each instance is `instances.rateLimitPerMinute`; the burst is the size of
# its token bucket (at most the rate). A new number starts at OUTBOUND_WARMUP_START_PERCENT of the rate
# and gets the full rate after OUTBOUND_WARMUP_DAYS (0 or 1 turns the warm-up off).
OUTBOUND_BUCKET_BURST=3
OUTBOUND_WARMUP_DAYS=7
OUTBOUND_WARMUP_START_PERCENT=20
# Validity of the pre-signed media URLs: the upload URL of POST /v1/media, and the download URL that
# the Evolution API gets for a media message.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_SEND_URL_TTL_SECONDS=900

# Inbound (bugfix/inbound-runtime). Media downloads that one worker runs at the same time (each can keep
# about 60 MiB in memory). The messages of one contact in one minute that the bot answers (the worker
# stores the others). The state timeouts in a row without an inbound message.
INBOUND_MEDIA_DOWNLOAD_CONCURRENCY=2
BOT_INBOUND_LIMIT_PER_MINUTE=30
BOT_MAX_TIMEOUTS_IN_ROW=3

# Webhooks and the external HTTP client (the `external` condition, `call_webhook`).
# EXTERNAL_HTTP_ALLOW_PRIVATE must stay false in production (the API refuses to start with true).
EXTERNAL_HTTP_ALLOW_PRIVATE=false
EXTERNAL_HTTP_MAX_RESPONSE_BYTES=1048576
# Pause of the outbox dispatcher of the worker when no event waits.
OUTBOX_DISPATCH_INTERVAL_MS=1000
