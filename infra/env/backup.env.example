# Host scripts of infra/backup and infra/host (systemd EnvironmentFile). Mode 600.
# The Compose project of the production stack (container labels).
BOTCENTER_COMPOSE_PROJECT=botcenter
# The env file of restic (repository and credentials). Only the restic container reads it.
RESTIC_ENV_FILE=/etc/botcenter/restic.env
# The host name in the restic snapshots.
BACKUP_HOST_TAG=botcenter-prod-1
# The text file metrics that Alloy reads (botcenter_backup_*, botcenter_restore_test_*).
METRICS_DIR=/var/lib/botcenter/metrics
# A temporary directory for the dumps (removed after each run).
BACKUP_WORK_DIR=/var/lib/botcenter/backup-work
# Discord webhook of the operations channel: failures of the backup, the restore test, and the disk check.
DISCORD_WEBHOOK_URL=CHANGE_ME
# Uptime Kuma push monitors (through Caddy on 127.0.0.1:3001). Empty: no heartbeat.
KUMA_PUSH_URL_BACKUP=http://127.0.0.1:3001/api/push/CHANGE_ME
KUMA_PUSH_URL_RESTORE_TEST=
# `restic check` runs on this day of the week (1 = Monday, 7 = Sunday).
BACKUP_CHECK_WEEKDAY=7
# Disk alert threshold in percent.
DISK_ALERT_PERCENT=80
# The restore test fails when the latest snapshot is older than this number of hours.
RESTORE_MAX_SNAPSHOT_AGE_HOURS=30
# Retention of the Evolution `Message` rows, in days (infra/host/evolution-retention.sh).
EVOLUTION_MESSAGE_RETENTION_DAYS=7
