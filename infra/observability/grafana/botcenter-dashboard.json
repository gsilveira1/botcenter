      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"botcenter-api\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
