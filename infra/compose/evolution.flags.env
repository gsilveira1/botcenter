# Fixed configuration of the Evolution API v2.3.7 (`evoapicloud/evolution-api`). No secret in this file.
# compose.dev.yml and compose.prod.yml load it. The secrets come from a second env file
# (AUTHENTICATION_API_KEY, DATABASE_CONNECTION_URI, CACHE_REDIS_URI): see infra/env/evolution.env.example.
#
# The image copies `.env.example` of the Evolution repository to /evolution/.env, and `dotenv` reads it
# for each variable that the container does not set. Its defaults save all the data and enable telemetry.
# Thus this file sets every flag explicitly. Source of the names: `.env.example` and
# `src/config/env.config.ts` of the Evolution repository at the tag 2.3.7.

# --- Server (internal network only; only the Bot Center calls it) ---
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://evolution:8080
SERVER_DISABLE_DOCS=true
SERVER_DISABLE_MANAGER=true
# CORS_ORIGIN must be `*`: the CORS check of v2.3.7 refuses a request without an Origin header
# ("Not allowed by CORS", status 500), and the server-to-server calls of the Bot Center have none.
# No browser can reach the Evolution API (internal network only).
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=false
LANGUAGE=en

# --- No telemetry, no Sentry, no metrics endpoint ---
TELEMETRY_ENABLED=false
TELEMETRY_URL=
SENTRY_DSN=
PROMETHEUS_METRICS=false

# --- Logs: errors and warnings only, no color codes (Alloy reads them as plain lines) ---
LOG_LEVEL=ERROR,WARN
LOG_COLOR=false
LOG_BAILEYS=error

# --- Instances stay in memory without a connection; the Bot Center deletes them through the API ---
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true

# --- Database ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=botcenter
# INSTANCE: the WhatsApp sessions (Baileys auth state) live in the `evolution` database, so the
#   PostgreSQL backup also keeps the connections.
# NEW_MESSAGE: Baileys calls `getMessage` to send a message again when a phone asks for a retry
#   (decryption failure). Without the stored message, the phone gets an empty text. The host timer
#   `evolution-retention` deletes the rows after 7 days.
# All the other flags are off: the Bot Center keeps its own messages, contacts, and statuses.
#   With HISTORIC=false, the `messages.update` webhook (delivered, read) does not need a stored update.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=false

# --- Redis cache (the URI with the password is a secret) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- Webhooks: no global webhook. The Bot Center sets the webhook of each instance. ---
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false
WEBHOOK_EVENTS_ERRORS=false
WEBHOOK_EVENTS_ERRORS_WEBHOOK=
WEBHOOK_REQUEST_TIMEOUT_MS=10000

# --- Event transports and integrations that the Bot Center does not use ---
RABBITMQ_ENABLED=false
RABBITMQ_GLOBAL_ENABLED=false
SQS_ENABLED=false
SQS_GLOBAL_ENABLED=false
NATS_ENABLED=false
NATS_GLOBAL_ENABLED=false
KAFKA_ENABLED=false
KAFKA_GLOBAL_ENABLED=false
PUSHER_ENABLED=false
PUSHER_GLOBAL_ENABLED=false
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false
PROVIDER_ENABLED=false
S3_ENABLED=false

# --- Name on the phone (WhatsApp > Linked devices) ---
CONFIG_SESSION_PHONE_CLIENT=Bot Center
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# --- The fetch of instances does not show the token of each instance ---
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
