# Edge proxy of Bot Center (Caddy 2). The only service with ports on the host.
#
# Rules (architecture, sections "Componentes" and "Segurança"):
#   - Only /v1/* and /health/* go to the API (api:3000). Every other path gets 404, so /internal/*
#     (the Evolution webhook) never reaches the API from the internet. The API has no /metrics route on
#     port 3000: its metrics listener (9465) is on the `metrics` network, which Caddy cannot reach.
#   - Request body limit: 2 MiB. Media goes to R2 through a pre-signed upload, not through this proxy.
#   - The client IP comes from CF-Connecting-IP only when the peer is a Cloudflare range
#     (cloudflare-ips.caddy). The API gets it in X-Forwarded-For and X-Real-IP (one value).
#   - SEC-14: Authenticated Origin Pulls are mandatory. The site asks for a TLS client certificate of the
#     Cloudflare origin pull CA (cloudflare-origin-pull-ca.pem). Only Cloudflare (with the setting on in
#     the zone) can connect, not a client of another Cloudflare account. Plain HTTP (port 80, ACME mode)
#     has no client certificate; it only answers the ACME challenge and redirects.
#   - The access log is JSON on stdout, without the query string, without the connect token of the
#     SSE path, and without request or response headers.
#
# Environment (caddy.env):
#   BOTCENTER_DOMAIN  The public host name, for example api.botcenter.example.
#   CADDY_TLS         The arguments of the `tls` directive:
#                       origin mode (recommended): /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
#                         (Cloudflare origin certificate, SSL mode "Full (strict)").
#                       ACME mode: an e-mail address, for example ops@botcenter.example
#                         (Let's Encrypt HTTP-01 through Cloudflare: the firewall must also open port 80
#                         for the Cloudflare ranges, see infra/host/firewall-cloudflare.sh --allow-http).
{
	# The admin API stays on localhost:2019 inside the container. `caddy reload` uses it.
	servers {
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
		# Cloudflare connects to the origin with HTTP/1.1 or HTTP/2. The firewall does not open UDP 443.
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
	log {
		output stdout
		format json
		level INFO
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		-Server
		-X-Powered-By
	}
}

(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# The connect token is part of the SSE path. A query string can also carry a secret.
				request>uri multi_regexp {
					regexp "^(/v1/connect/)[^/?]+" "${1}REDACTED"
					regexp "\?.*$" "?REDACTED"
				}
				request>headers delete
				resp_headers delete
				request>tls delete
			}
		}
	}
}

(api_upstream) {
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		# Below KEEP_ALIVE_TIMEOUT_MS of the API (65 s): Caddy never reuses a connection that the API closed.
		transport http {
			keepalive 60s
		}
		{block}
	}
}

{$BOTCENTER_DOMAIN} {
	tls {$CADDY_TLS} {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
		}
	}
	import security_headers
	import access_log

	request_body {
		max_size 2MB
	}

	# No path traversal and no encoded separators. The API ids are UUIDs.
	@suspicious path_regexp (?i)(\.\.|%2e|%2f|%5c|//)
	handle @suspicious {
		respond 400
	}

	# Server-Sent Events of the connect flow: no buffer and no compression.
	@connect_events path_regexp ^/v1/connect/[^/]+/events$
	handle @connect_events {
		import api_upstream {
			flush_interval -1
		}
	}

	handle /v1/* {
		encode zstd gzip
		import api_upstream
	}

	handle /health/* {
		import api_upstream
	}

	handle {
		header Content-Type "application/problem+json"
		respond `{"type":"about:blank","title":"Not Found","status":404}` 404
	}
}

# Health check of the container (not published on the host).
http://:8081 {
	respond /healthz "ok" 200
	respond 404
}

# Uptime Kuma UI. Compose publishes this port on 127.0.0.1 of the host only (SSH tunnel through Tailscale).
http://:3001 {
	reverse_proxy uptime-kuma:3001
}
